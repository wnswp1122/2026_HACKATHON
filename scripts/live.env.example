# Linux 호스트에 복사하고 chmod 600. 셸 문법/따옴표/변수 확장을 사용하지 않는다.
# 기존 수집기와 SaaS는 미리 실행한다. 이 도구는 전송기 두 개만 관리한다.
EVENTS_URL=http://127.0.0.1:8000/api/events
STATUS_URL=http://127.0.0.1:8000/api/sensor-status
INSTANCE_ID=board-server-01
INGEST_TOKEN=
TETRAGON_LOG_PATH=/home/user/2026-hack-runtime/tetragon/events.jsonl
STATUS_PATH=/home/user/2026-hack-runtime/tetragon/status.json
FORWARDER_DIR=/home/user/2026_hack/event-forwarder
FORWARDER_PYTHON=/home/user/2026_hack/event-forwarder/.venv/bin/python
# 선택: 영속 전송 지원 버전의 전송기에서만 사용. 별도 절대 경로.
SPOOL_DIR=
