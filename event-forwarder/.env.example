# 직접 작성한 신뢰할 수 있는 .env만 셸에서 로드한다. 자동 로딩하지 않는다.
EVENTS_URL=http://127.0.0.1:8000/api/events
INSTANCE_ID=board-server-01
# 실제 토큰은 로컬 .env에만 작성한다. 출력하거나 커밋하지 않는다.
INGEST_TOKEN=
# 실행 호스트에서 읽을 JSONL 절대 경로. 이벤트 replay/check-config에도 필요하다.
TETRAGON_LOG_PATH=/absolute/path/to/events.jsonl
# 상태 모드 전용. EVENTS_URL에서 경로를 조합하지 않는다.
STATUS_URL=http://127.0.0.1:8000/api/sensor-status

# 선택적 영속 복구는 환경변수가 아닌 CLI로 설정한다. 기존 모드의 기본값은 유지한다.
# python event-forwarder/main.py --follow --spool-dir event-forwarder/.local/spool
# 큐에는 원본이 저장되므로 Git 제외 경로와 owner 전용 권한을 사용한다.
# --spool-max-bytes 67108864: SQLite 본 파일 한도, journal/파일시스템 여유 공간은 별도.
