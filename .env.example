# Local development only. Copy only if .env does not exist; never commit actual tokens.
# In a Linux VM, localhost refers to the VM. Set the URL supplied by the SaaS teammate.
EVENTS_URL=http://127.0.0.1:8000/api/events
INSTANCE_ID=board-server-01
INGEST_TOKEN=
# Absolute path on the host where the forwarder runs. Fill after environment setup.
TETRAGON_LOG_PATH=
# Optional board DB override. Defaults to demo/.local/board.sqlite3 on host.
# Container default: /data/board.sqlite3
# BOARD_DB_PATH=
