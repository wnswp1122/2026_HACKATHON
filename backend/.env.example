# .env 자동 로딩 없음. 신뢰할 수 있는 로컬 파일을 직접 export한 뒤 실행한다.
# 아래 포트는 SSH 터널을 열었을 때의 macOS 연결 예시다.
DATABASE_URL=postgresql://saas@127.0.0.1:15432/saas
# 필수. 실제 토큰은 Git/명령 인자/브라우저에 넣지 않는다.
INGEST_TOKEN=
INSTANCE_IDS=board-server-01
# process_kprobe.policy_name과 정확히 일치할 때만 attention
ATTENTION_POLICY_NAMES=
# 선택. 명시적으로 지정한 IP/서버 위치 JSON. 미설정이면 위치 미확인으로 표시한다.
DASHBOARD_LOCATIONS_FILE=
# 선택. 실제 AI 요청을 사용할 때만 서버에서 설정한다. 미설정 분석 요청은 503이다.
OPENAI_API_KEY=
OPENAI_MODEL=
